# CMake build trees must use a profile subdirectory such as
# build/debug-neutral/, never the build/ container itself.
/build/*
/build-*/
/cmake-build-*/
/runs/
compile_commands.json

# Python caches and test/coverage outputs
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Editor and operating-system files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Local environment files
.env
.env.*
!.env.example
