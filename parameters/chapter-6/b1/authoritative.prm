# Proposed nmopt ParameterHandler input.
# This file is a run-set definition: no Selection section means all 8 cases.

subsection Benchmark
  set id = chapter-6.b1.distributed-laplace
  set label = E6.5.1 distributed Laplace control
  set recipe = chapter-5.scalar-diffusion-reaction-volume
  set source reference = E6.5.1 equations (6.64), Figures 6.2-6.3
  set source revision = 1aaefbe473f9941a89d1df36192251511c052933
end

subsection Matrix
  set method = steepest-descent, l-bfgs
  set regularisation = 1e-1, 1e-2, 1e-3, 1e-6
end

subsection Problem
  set control representation = cellwise-volume
  set cellwise box constraint = false
  set observation = full-domain
end

subsection Functions
  set forcing = manufactured-zero
  set desired state = b1-polynomial

  subsection forcing
    set kind = zero
    set provenance = chapter-6.e6.5.1.manufactured-zero-forcing
  end

  subsection desired state
    set kind = polynomial
    set expression = 10*x0*(1-x0)*x1*(1-x1)
    set provenance = chapter-6.e6.5.1.desired-state
  end
end

subsection Runtime
  set diffusion = 1.0
  set reaction = 0.0
end

subsection Mesh
  set dimension = 2
  set geometry = unit-hypercube
  set refinement = 7
  set provenance = chapter-6.e6.5.1.framework-native-hypercube-r7
end

subsection Compile
  set state degree = 1
  set execution = assembled
  set product = reduced-dto
  set owned session = true
end

subsection Solver
  set method = from-matrix
  set initial control = zero
  set maximum iterations = 100
  set maximum line search trials = 5
  set stopping criterion = automatic
  set relative gradient tolerance = 0.0
  set objective change tolerance = 0.0
  set step tolerance = 0.0
  set initial step length = 1.0
  set Armijo fraction = 1e-5
  set backtracking factor = 0.7

  subsection method policy steepest-descent
    set gradient tolerance = 1e-3
    set declared minimum step length = 0.2
  end

  subsection method policy l-bfgs
    set gradient tolerance = 1e-8
    set declared minimum step length = 0.01
  end
end

subsection Run
  set kind = reproduction
  set build profile = release-dealii
  set output root = runs
  set deterministic = true
  set serialize artifacts = true
  set measure timings = true
  set measure memory = false
end

subsection Output
  set retain fields = true
  set selected fields = state, control, adjoint, negative-adjoint, target, forcing
end

subsection Postprocessing
  set style profile = parameters/plotting/chapter-6-b1.json
  set comparison rows = method
  set comparison columns = regularisation
  set comparison group by = none
  set output formats = png
end
