{
  "schema": "nmopt-plot-v1",
  "profile_id": "chapter-6.b2",
  "compatible_scenario_prefixes": [
    "chapter-6.b2.graetz-flow"
  ],
  "defaults": {
    "colormap": "turbo",
    "normalization": "finite-extrema",
    "comparison_normalization": "shared-finite-extrema",
    "volume_interpolation": "gouraud",
    "volume_mesh_overlay": false,
    "colorbar_ticks": "endpoint-inclusive",
    "colorbar_tick_count": 5,
    "output_formats": ["png"],
    "dpi": 180,
    "axis_labels": ["x", "y"]
  },
  "fields": {
    "state": {
      "source": "state",
      "title": "State with optimized control",
      "colorbar_label": "state"
    },
    "state-no-control": {
      "source": "state_uncontrolled",
      "title": "State without control (u = 0)",
      "colorbar_label": "state (u = 0)"
    },
    "control-boundary": {
      "source": "control",
      "mesh": "boundary",
      "title": "Boundary control",
      "colorbar_label": "control"
    },
    "adjoint": {
      "source": "adjoint",
      "title": "Framework adjoint",
      "colorbar_label": "adjoint"
    },
    "negative-adjoint": {
      "source": "negative_adjoint",
      "title": "Book-convention adjoint (-p)",
      "colorbar_label": "-p"
    },
    "target": {
      "source": "target",
      "title": "Target function",
      "colorbar_label": "target"
    },
    "forcing": {
      "source": "forcing",
      "title": "Forcing function",
      "colorbar_label": "forcing"
    },
    "observation-region": {
      "source": "observation_region",
      "title": "Observation region",
      "colorbar_label": "observation domain"
    }
  },
  "axes": {
    "observation-region": {
      "order": ["wings", "full"],
      "labels": {
        "wings": "wings",
        "full": "full domain"
      }
    },
    "target-profile": {
      "order": ["constant", "parabolic"],
      "labels": {
        "constant": "constant target",
        "parabolic": "parabolic target"
      }
    },
    "forcing": {
      "labels_from": "matrix"
    }
  },
  "default_comparison": {
    "rows": ["target-profile"],
    "columns": ["observation-region"],
    "group_by": []
  },
  "title_templates": {
    "state": "B2 state — {observation-region}, {target-profile}",
    "state-no-control": "B2 state without control — {observation-region}, {target-profile}",
    "control-boundary": "B2 boundary control — {observation-region}, {target-profile}",
    "adjoint": "B2 adjoint — {observation-region}, {target-profile}",
    "negative-adjoint": "B2 negative adjoint — {observation-region}, {target-profile}",
    "target": "B2 target function — {target-profile}",
    "forcing": "B2 forcing function — {forcing}",
    "observation-region": "B2 observation domains"
  }
}
